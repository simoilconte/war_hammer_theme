{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "command-deck",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "imperial-chrome"
              },
              "size": {
                "px": 158
              },
              "window_drag": true
            },
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "imperial-spaces"
                  },
                  "size": {
                    "px": 155
                  },
                  "min": 64
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "imperial-agents"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 120
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "imperial-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 98
              }
            }
          ],
          "size": {
            "px": 350
          },
          "min": 76,
          "max": 640,
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "imperial-tabs"
              },
              "size": {
                "px": 32
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "imperial-pane"
                        },
                        "reveal": "always",
                        "height": 27,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "accent"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 3,
                      "gap": 6,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": 4,
              "gap": 8
            }
          ],
          "resizable": false
        }
      ],
      "divider": {
        "width": 1,
        "color": "accent"
      }
    },
    {
      "id": "status",
      "type": "block",
      "content": {
        "mod": "imperial-status"
      },
      "size": {
        "px": 30
      }
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "toast": "imperial-toast",
  "theme": "imperial-command",
  "ui_font": "Geist",
  "preview": "layouts/imperial-command.svg"
}
